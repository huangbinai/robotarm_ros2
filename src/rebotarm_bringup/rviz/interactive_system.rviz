Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane Cell Count: 20
      Reference Frame: base_link
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: false
        base_link:
          Value: false
        end_link:
          Value: true
        grasp_tcp:
          # The generic MoveIt launch does not publish the vision/calibration
          # TCP frame.  Keep it disabled here; visual_grasp.rviz enables it
          # together with rebotarm_grasp_tcp_frame.
          Value: false
      Marker Scale: 0.08
      Name: TCP TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        base_link:
          {}
      Update Interval: 0
    - Class: moveit_rviz_plugin/MotionPlanning
      Enabled: true
      Name: MotionPlanning
      Planned Path:
        Loop Animation: false
        State Display Time: 0.05 s
        Trajectory Topic: /display_planned_path
      Planning Request:
        Planning Group: arm
      Scene Geometry:
        Scene Alpha: 0.9
      Scene Robot:
        Robot Alpha: 0.5
      Robot Description: robot_description
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_link
  Name: root
  Tools:
    # MoveIt's end-effector marker only accepts drag commands while this tool
    # is active.  Keep it first so it is the default toolbar tool.
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
Window Geometry:
  Height: 900
  Width: 1400
