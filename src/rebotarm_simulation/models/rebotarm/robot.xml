<?xml version="1.0" encoding="utf-8"?>
<mujoco model="rebotarm">
  <compiler angle="radian" eulerseq="XYZ" meshdir="assets" autolimits="false"/>

  <default>
    <geom solref="0.01 1" solimp="0.9 0.95 0.001" friction="0.8 0.02 0.001"/>
    <default class="visual">
      <geom type="mesh" contype="0" conaffinity="0" group="2" rgba="0.63 0.63 0.63 1"/>
    </default>
    <default class="collision">
      <geom contype="1" conaffinity="1" group="3" rgba="0.2 0.5 0.8 0.18"/>
    </default>
  </default>

  <asset>
    <mesh name="base_link" file="base_link.STL"/>
    <mesh name="link1" file="link1.STL"/>
    <mesh name="link2" file="link2.STL"/>
    <mesh name="link3" file="link3.STL"/>
    <mesh name="link4" file="link4.STL"/>
    <mesh name="link5" file="link5.STL"/>
    <mesh name="link6" file="link6.STL"/>
    <mesh name="gripper_base" file="gripper_base.stl"/>
    <mesh name="left_finger" file="left_finger.stl"/>
    <mesh name="right_finger" file="right_finger.stl"/>
  </asset>

  <worldbody>
    <body name="base_link">
      <inertial pos="-0.000007849 -0.0000011531 0.029841" mass="0.8366" fullinertia="0.00133040 0.00213119 0.00275877 0.00000001 0 0"/>
      <geom name="base_visual" class="visual" mesh="base_link"/>
      <geom name="base_collision" class="collision" type="cylinder" pos="0 0 0.035" size="0.065 0.035" contype="1" conaffinity="1"/>

      <body name="link1" pos="-0.00008416 0 0.08465" euler="0 0 0">
        <joint name="joint1" type="hinge" axis="0 0 1" range="-2.8 2.8" limited="true"/>
        <inertial pos="0.000113614552951627 -0.000616319527051323 0.0236476372671394" mass="0.1613" fullinertia="0.00025207 0.00015464 0.00023416 0 -0.00002832 0"/>
        <geom name="link1_visual" class="visual" mesh="link1"/>
        <geom name="link1_collision" class="collision" type="cylinder" pos="0 0 0.025" size="0.024 0.04" contype="1" conaffinity="1"/>

        <body name="link2" pos="0.020084 0.031625 0.05555" euler="-1.5708 0 0">
          <joint name="joint2" type="hinge" axis="0 0 -1" range="-3.14 0" limited="true"/>
          <inertial pos="-0.13225622308888 -0.0030617036386309 -0.0308306967030205" mass="1.3266" fullinertia="0.00073374 0.01255987 0.01281387 -0.00000043 0.00000851 0.00000128"/>
          <geom name="link2_visual" class="visual" mesh="link2"/>
          <geom name="link2_collision" class="collision" type="capsule" fromto="-0.018 0 0 -0.246 0 0" size="0.024" contype="1" conaffinity="1"/>

          <body name="link3" pos="-0.264 0 0" euler="0 0 0">
            <joint name="joint3" type="hinge" axis="0 0 1" range="-3.14 0" limited="true"/>
            <inertial pos="0.121040035791843 -0.0536211076627949 -0.0310137854608077" mass="0.8353" fullinertia="0.00046807 0.00632695 0.00648221 -0.00003456 -0.00004260 0.00000006"/>
            <geom name="link3_visual" class="visual" mesh="link3"/>
            <geom name="link3_collision" class="collision" type="capsule" fromto="0.018 -0.004 0 0.2246 -0.050 0" size="0.024" contype="1" conaffinity="1"/>

            <body name="link4" pos="0.2426 -0.054 -0.001625" euler="0 0 0">
              <joint name="joint4" type="hinge" axis="0 0 1" range="-1.87 1.57" limited="true"/>
              <inertial pos="0.0608200956293136 -0.0511711906613122 -0.030299458623927" mass="0.52" fullinertia="0.00045986 0.00075258 0.00066742 0.00024219 -0.00000672 -0.00000535"/>
              <geom name="link4_visual" class="visual" mesh="link4"/>
              <geom name="link4_collision" class="collision" type="capsule" fromto="0.012 -0.006 -0.005 0.066308 -0.0315 -0.025" size="0.022" contype="1" conaffinity="1"/>

              <body name="link5" pos="0.078308 -0.0375 -0.03" euler="-1.5708 0 0">
                <joint name="joint5" type="hinge" axis="0 0 1" range="-1.57 1.57" limited="true"/>
                <inertial pos="-0.00502802058982517 0.00000173866206692364 0.0386233236326755" mass="0.383" fullinertia="0.00019772 0.00021737 0.00017191 -0.00000062 -0.00002426 0.00000002"/>
                <geom name="link5_visual" class="visual" mesh="link5"/>
                <geom name="link5_collision" class="collision" type="capsule" fromto="0.006 0 0.008 0.022008 0 0.032" size="0.020" contype="1" conaffinity="1"/>

                <body name="link6" pos="0.028008 0 0.04" euler="0 1.5708 0">
                  <joint name="joint6" type="hinge" axis="0 0 1" range="-3.14 3.14" limited="true"/>
                  <inertial pos="0.00000376418727127126 -0.000100908819946677 0.0253308606425965" mass="0.3663" fullinertia="0.00015554 0.00015554 0.00013966 0 0 0"/>
                  <geom name="link6_visual" class="visual" mesh="link6"/>
                  <geom name="link6_collision" class="collision" type="cylinder" pos="0 0 0.055" size="0.023 0.035" contype="1" conaffinity="1"/>

                  <body name="end_link" pos="0 0 0.15539" euler="0 -1.5708 3.1415">
                    <inertial pos="-0.0737654295815033 -0.0000095080995865868 0.00000704327840286845" mass="0.5" fullinertia="0.00037354 0.00015830 0.00045353 -0.00000011 0.00000050 0.00000348"/>
                    <geom name="gripper_base_visual" class="visual" mesh="gripper_base"/>
                    <geom name="gripper_base_collision" class="collision" type="box" pos="-0.04 0 0" size="0.06 0.04 0.025" contype="1" conaffinity="1"/>
                    <site name="ee_site" pos="-0.105 0 0" size="0.008" rgba="1 0.2 0.1 1"/>
                    <!-- Stable wrist-relative frame reserved for a future hand-eye camera. -->
                    <site name="wrist_camera_mount" pos="-0.04 0 0.04" quat="1 0 0 0" size="0.005" rgba="0.2 0.7 1 1"/>

                    <body name="left_finger_link" pos="0 0 0" euler="0 0 0">
                      <joint name="left_finger_joint" type="slide" axis="0 1 0" range="0 0.045" limited="true"/>
                      <inertial pos="-0.08 0.012 0" mass="0.025" diaginertia="0.000012 0.000045 0.000045"/>
                      <geom name="left_finger_visual" class="visual" mesh="left_finger"/>
                      <geom name="left_finger_collision" class="collision" type="box" pos="-0.085 0.012 0" size="0.055 0.008 0.012" contype="1" conaffinity="1" friction="1.2 0.02 0.001"/>
                    </body>

                    <body name="right_finger_link" pos="0 0 0" euler="0 0 0">
                      <joint name="right_finger_joint" type="slide" axis="0 1 0" range="-0.045 0" limited="true"/>
                      <inertial pos="-0.08 -0.012 0" mass="0.025" diaginertia="0.000012 0.000045 0.000045"/>
                      <geom name="right_finger_visual" class="visual" mesh="right_finger"/>
                      <geom name="right_finger_collision" class="collision" type="box" pos="-0.085 -0.012 0" size="0.055 0.008 0.012" contype="1" conaffinity="1" friction="1.2 0.02 0.001"/>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <contact>
    <exclude body1="base_link" body2="link1"/>
    <exclude body1="link1" body2="link2"/>
    <exclude body1="link2" body2="link3"/>
    <exclude body1="link3" body2="link4"/>
    <exclude body1="link4" body2="link5"/>
    <exclude body1="link5" body2="link6"/>
    <exclude body1="link6" body2="end_link"/>
    <exclude body1="end_link" body2="left_finger_link"/>
    <exclude body1="end_link" body2="right_finger_link"/>
  </contact>

  <equality>
    <joint name="finger_coupling" joint1="right_finger_joint" joint2="left_finger_joint" polycoef="0 -1 0 0 0"/>
  </equality>

  <actuator>
    <!-- Gains are the lowest tested set that sustains the ROS 0.02 rad / 0.05 rad/s settle contract. -->
    <position name="joint1_position" joint="joint1" kp="480" kv="1" ctrlrange="-2.8 2.8" ctrllimited="true" forcelimited="true" forcerange="-27 27"/>
    <position name="joint2_position" joint="joint2" kp="480" kv="1" ctrlrange="-3.14 0" ctrllimited="true" forcelimited="true" forcerange="-27 27"/>
    <position name="joint3_position" joint="joint3" kp="400" kv="0.75" ctrlrange="-3.14 0" ctrllimited="true" forcelimited="true" forcerange="-27 27"/>
    <position name="joint4_position" joint="joint4" kp="240" kv="0.5" ctrlrange="-1.87 1.57" ctrllimited="true" forcelimited="true" forcerange="-7 7"/>
    <position name="joint5_position" joint="joint5" kp="200" kv="0.375" ctrlrange="-1.57 1.57" ctrllimited="true" forcelimited="true" forcerange="-7 7"/>
    <position name="joint6_position" joint="joint6" kp="160" kv="0.25" ctrlrange="-3.14 3.14" ctrllimited="true" forcelimited="true" forcerange="-7 7"/>
    <position name="left_finger_position" joint="left_finger_joint" kp="250" kv="0.125" ctrlrange="0 0.045" ctrllimited="true" forcelimited="true" forcerange="-1 1"/>
    <position name="right_finger_position" joint="right_finger_joint" kp="250" kv="0.125" ctrlrange="-0.045 0" ctrllimited="true" forcelimited="true" forcerange="-1 1"/>
  </actuator>

  <sensor>
    <jointpos name="joint1_pos" joint="joint1"/><jointvel name="joint1_vel" joint="joint1"/>
    <jointpos name="joint2_pos" joint="joint2"/><jointvel name="joint2_vel" joint="joint2"/>
    <jointpos name="joint3_pos" joint="joint3"/><jointvel name="joint3_vel" joint="joint3"/>
    <jointpos name="joint4_pos" joint="joint4"/><jointvel name="joint4_vel" joint="joint4"/>
    <jointpos name="joint5_pos" joint="joint5"/><jointvel name="joint5_vel" joint="joint5"/>
    <jointpos name="joint6_pos" joint="joint6"/><jointvel name="joint6_vel" joint="joint6"/>
    <jointpos name="left_finger_pos" joint="left_finger_joint"/><jointvel name="left_finger_vel" joint="left_finger_joint"/>
    <jointpos name="right_finger_pos" joint="right_finger_joint"/><jointvel name="right_finger_vel" joint="right_finger_joint"/>
    <actuatorfrc name="joint1_force" actuator="joint1_position"/>
    <actuatorfrc name="joint2_force" actuator="joint2_position"/>
    <actuatorfrc name="joint3_force" actuator="joint3_position"/>
    <actuatorfrc name="joint4_force" actuator="joint4_position"/>
    <actuatorfrc name="joint5_force" actuator="joint5_position"/>
    <actuatorfrc name="joint6_force" actuator="joint6_position"/>
    <actuatorfrc name="left_finger_force" actuator="left_finger_position"/>
    <actuatorfrc name="right_finger_force" actuator="right_finger_position"/>
    <framepos name="ee_position" objtype="site" objname="ee_site"/>
    <framequat name="ee_orientation" objtype="site" objname="ee_site"/>
  </sensor>
</mujoco>
